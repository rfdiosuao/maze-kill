.grid { display: flex; flex-wrap: wrap; padding: 16rpx 12rpx; }
.dm {
  width: calc(50% - 24rpx); margin: 12rpx;
  background: linear-gradient(135deg, #1A1113, #120C0D);
  border: 1rpx solid rgba(212,175,55,.2); border-radius: 16rpx; overflow: hidden;
}
.photo { width: 100%; height: 320rpx; background: #241719; display: block; }
.dm-name { font-size: 30rpx; font-weight: 600; color: #D4AF37; padding: 16rpx 20rpx 4rpx; }
.dm-tags { padding: 4rpx 20rpx; }
.dm-intro { padding: 8rpx 20rpx 20rpx; font-size: 22rpx; }
