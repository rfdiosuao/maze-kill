<view class="grid">
  <view class="dm" wx:for="{{list}}" wx:key="id">
    <image class="photo" src="{{item.photo}}" mode="aspectFill" />
    <view class="dm-name">{{item.stage_name}}</view>
    <view class="dm-tags">
      <text class="tag" wx:for="{{item.tagsArr}}" wx:for-item="t" wx:key="*this">{{t}}</text>
    </view>
    <view class="dm-intro muted">{{item.intro}}</view>
  </view>
</view>
<view wx:if="{{!list.length}}" class="empty">DM资料整理中</view>
