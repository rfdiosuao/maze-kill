.bar { padding: 20rpx 24rpx 4rpx; }
.search-wrap {
  display: flex; align-items: center; gap: 12rpx;
  height: 72rpx; padding: 0 28rpx;
  background: rgba(255, 255, 255, .05);
  border: 1rpx solid rgba(212, 175, 55, .35); border-radius: 999rpx;
}
.search-ic { width: 28rpx; height: 28rpx; flex-shrink: 0; opacity: .6; }
.search {
  flex: 1; min-width: 0; height: 72rpx;
  background: transparent; border: none; padding: 0;
  color: #F5EFE6; font-size: 26rpx;
}
.ph { color: #8C8680; font-size: 26rpx; }
.chips { display: flex; gap: 12rpx; padding: 16rpx 24rpx 0; }
.chips-x { white-space: nowrap; padding: 12rpx 24rpx; width: auto; }
.chips-x .chip { display: inline-block; }
.chip {
  font-size: 24rpx; padding: 8rpx 22rpx; border-radius: 999rpx;
  border: 1rpx solid rgba(212,175,55,.3); color: #8C8680; margin-right: 8rpx;
}
.chip.on { background: rgba(177,18,24,.3); border-color: #B11218; color: #F5EFE6; }
.total { padding: 0 28rpx; }
.script {
  display: flex; gap: 20rpx; margin: 16rpx 24rpx; padding: 20rpx;
  background: linear-gradient(135deg, #1A1113, #120C0D);
  border: 1rpx solid rgba(212,175,55,.18); border-radius: 16rpx;
}
.cover { width: 150rpx; height: 200rpx; border-radius: 10rpx; background: #241719; flex-shrink: 0; }
.info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.name { font-size: 30rpx; font-weight: 600; }
.meta { margin: 6rpx 0; }
.price { font-size: 30rpx; }

/* 底部固定导航留白（底栏高≈96rpx + 安全区） */
.tab-space {
  height: calc(96rpx + constant(safe-area-inset-bottom));
  height: calc(96rpx + env(safe-area-inset-bottom));
}
