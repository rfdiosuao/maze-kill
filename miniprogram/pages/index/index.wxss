/* ============================================================
   谜宫 · 玩家端首页 —— 按 migong-ui 设计令牌实现
   主红 #C02027 / 暗红 #8B1418 / 中式金 #C9A063 / 亮金 #E0C48A
   页底 #100D0E / 卡片 #1C1618 / 浮层 #241E20 / 描边 #332B2D
   ============================================================ */
page { background: #100D0E; }

/* 全屏背景图层（置于内容之下，底部与底色自然衔接） */
.page-bg {
  position: fixed; top: 0; left: 0; z-index: -1;
  width: 100%;
}

.serif { font-family: "Songti SC", "STSong", "Noto Serif SC", "SimSun", serif; }

/* ===== 顶部栏 ===== */
.nav {
  background: linear-gradient(180deg, rgba(16, 13, 14, .88) 0%, rgba(16, 13, 14, .45) 60%, rgba(16, 13, 14, 0) 100%);
}
.nav-row {
  display: flex; align-items: center; gap: 16rpx;
  height: 88rpx; padding: 0 32rpx;
}
.nav-logo { height: 76rpx; flex-shrink: 0; }
.nav-title {
  flex-shrink: 1; min-width: 0;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx; font-weight: 600; letter-spacing: 1rpx;
  color: #F4EBE9; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.nav-search {
  flex: 1; min-width: 0; height: 60rpx; padding: 0 20rpx;
  display: flex; align-items: center; gap: 10rpx;
  background: rgba(36, 30, 32, .7); backdrop-filter: blur(4rpx); border-radius: 999rpx;
  color: #6F6668; font-size: 24rpx;
}
.nav-search-ic { width: 26rpx; height: 26rpx; flex-shrink: 0; }
.nav-search-txt { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.nav-cap { flex-shrink: 0; height: 1px; }

/* ===== 主 Banner ===== */
.banner {
  position: relative; overflow: hidden;
  margin: 120rpx 32rpx 0; padding: 48rpx 40rpx 44rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, rgba(42, 14, 16, .55) 0%, rgba(16, 13, 14, .3) 60%, rgba(26, 16, 16, .5) 100%);
  backdrop-filter: blur(4rpx);
  border: 1rpx solid rgba(201, 160, 99, .18);
  box-shadow: 0 0 24rpx rgba(192, 32, 39, .2);
}
.banner::before {
  content: ''; position: absolute; top: -40rpx; right: -40rpx;
  width: 260rpx; height: 260rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(192, 32, 39, .35) 0, transparent 70%);
}
.banner::after {
  content: ''; position: absolute; bottom: -60rpx; left: 30%;
  width: 360rpx; height: 200rpx;
  background: radial-gradient(ellipse, rgba(201, 160, 99, .18) 0, transparent 60%);
}
.banner-tag {
  display: inline-block; padding: 6rpx 14rpx; margin-bottom: 20rpx;
  background: rgba(201, 160, 99, .15);
  border: 1rpx solid rgba(201, 160, 99, .35);
  color: #E0C48A; font-size: 20rpx; letter-spacing: 2rpx; border-radius: 6rpx;
}
.banner-title {
  position: relative; z-index: 1;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 50rpx; font-weight: 700; color: #F4EBE9;
  letter-spacing: 4rpx; line-height: 1.25;
}
.banner-title .accent { color: #C02027; }
.banner-sub {
  position: relative; z-index: 1;
  font-size: 24rpx; color: #ABA0A0; letter-spacing: 1rpx;
  margin: 14rpx 0 30rpx;
}
.banner-actions { position: relative; z-index: 1; display: flex; gap: 14rpx; }
.banner-btn {
  display: flex; align-items: center; gap: 8rpx;
  height: 60rpx; padding: 0 22rpx;
  background: rgba(192, 32, 39, .85);
  border: 1rpx solid rgba(224, 196, 138, .4);
  border-radius: 999rpx;
  color: #FFF8F2; font-size: 22rpx;
}
.banner-btn.secondary {
  background: rgba(244, 235, 233, .06);
  border-color: rgba(244, 235, 233, .2);
  color: #F4EBE9;
}
.banner-btn-ic { width: 24rpx; height: 24rpx; }

/* ===== 四宫格 ===== */
.grid-4 {
  display: flex; justify-content: space-between;
  margin: 40rpx 32rpx 0;
}
.grid-item {
  position: relative; overflow: hidden; box-sizing: border-box;
  width: 162rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx;
  padding: 32rpx 0;
  background: rgba(28, 22, 24, .55); backdrop-filter: blur(4rpx);
  border: 1rpx solid rgba(201, 160, 99, .4); border-radius: 24rpx;
  box-shadow:
    inset 0 0 0 3rpx rgba(16, 13, 14, .65),
    inset 0 0 24rpx rgba(201, 160, 99, .08),
    0 8rpx 20rpx rgba(0, 0, 0, .35);
}
.grid-item::before {
  content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  width: 44rpx; height: 5rpx;
  background: linear-gradient(90deg, #8B1418, #E03A3F, #8B1418);
  border-radius: 0 0 8rpx 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(192, 32, 39, .6);
}
.grid-item::after {
  content: ''; position: absolute; inset: 6rpx;
  border: 1rpx solid rgba(201, 160, 99, .18); border-radius: 18rpx;
  pointer-events: none;
}
.grid-icon {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, rgba(224, 58, 63, .4) 0%, rgba(139, 20, 24, .3) 55%, rgba(42, 14, 16, .55) 100%);
  border: 1rpx solid rgba(224, 196, 138, .6);
  box-shadow:
    inset 0 0 0 4rpx rgba(16, 13, 14, .5),
    inset 0 0 14rpx rgba(192, 32, 39, .4),
    0 0 18rpx rgba(192, 32, 39, .35),
    0 4rpx 10rpx rgba(0, 0, 0, .4);
  display: flex; align-items: center; justify-content: center;
}
.grid-icon-img { width: 46rpx; height: 46rpx; }
.grid-label {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 24rpx; letter-spacing: 1rpx; color: #F4EBE9;
}

/* ===== 模块头 ===== */
.section { margin: 48rpx 0 0 32rpx; }
.section-head {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 24rpx; padding-right: 32rpx;
}
.section-title {
  display: flex; align-items: center; gap: 12rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx; font-weight: 700; letter-spacing: 2rpx; color: #F4EBE9;
}
.section-title::before {
  content: ''; width: 6rpx; height: 28rpx;
  background: #C02027; border-radius: 4rpx;
}
.section-more { font-size: 22rpx; color: #ABA0A0; }

/* ===== 横滑通用 ===== */
.h-scroll { white-space: nowrap; }

/* ===== 剧本卡片 ===== */
.script-card {
  display: inline-block; vertical-align: top;
  width: 280rpx; margin-right: 20rpx;
  background: rgba(28, 22, 24, .72); backdrop-filter: blur(4rpx);
  border: 1rpx solid rgba(51, 43, 45, .8); border-radius: 24rpx;
  overflow: hidden;
}
.script-cover {
  position: relative; width: 280rpx; height: 373rpx;
  background: linear-gradient(135deg, #2A0E10, #161112);
}
.script-cover image { width: 100%; height: 100%; display: block; }
.cover-fallback {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 110rpx; color: rgba(201, 160, 99, .25);
}
.badge {
  position: absolute; top: 12rpx; left: 12rpx;
  padding: 4rpx 12rpx; font-size: 20rpx; font-weight: 600; border-radius: 8rpx;
}
.badge-city { background: #3E7CB1; color: #FFF; }
.badge-exclusive { background: #C9A063; color: #1B1415; }
.badge-live { background: rgba(16, 13, 14, .55); border: 1rpx solid #C02027; color: #E03A3F; }
.badge-box { background: #6F6668; color: #FFF; }
.script-meta { padding: 16rpx; }
.script-name {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx; font-weight: 600; color: #F4EBE9;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.chip-static {
  display: inline-block; margin-top: 10rpx;
  height: 36rpx; line-height: 36rpx; padding: 0 14rpx;
  background: #2A2325; border: 1rpx solid #332B2D; border-radius: 12rpx;
  font-size: 20rpx; color: #ABA0A0;
}

/* ===== DM 卡片 ===== */
.dm-card {
  display: inline-flex; flex-direction: column; align-items: center; gap: 10rpx;
  width: 200rpx; margin-right: 20rpx; padding: 24rpx 0 20rpx;
  background: rgba(28, 22, 24, .6); backdrop-filter: blur(4rpx);
  border: 1rpx solid rgba(51, 43, 45, .8); border-radius: 24rpx;
}
.dm-avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%; overflow: hidden;
  border: 2rpx solid #C02027;
  box-shadow: 0 0 24rpx rgba(192, 32, 39, .2);
  background: linear-gradient(135deg, #2A0E10, #161112);
}
.dm-avatar image { width: 100%; height: 100%; display: block; }
.avatar-fallback {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 48rpx; color: rgba(201, 160, 99, .5);
}
.dm-name {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx; font-weight: 600; color: #F4EBE9;
}
.dm-style { font-size: 20rpx; color: #ABA0A0; }

/* ===== 会员卡横条 ===== */
.member-bar {
  position: relative; overflow: hidden;
  display: flex; align-items: center; justify-content: space-between;
  margin: 160rpx 32rpx 0; padding: 28rpx;
  background: linear-gradient(135deg, rgba(26, 15, 15, .7) 0%, rgba(42, 20, 20, .65) 100%);
  backdrop-filter: blur(4rpx);
  border: 1rpx solid #C9A063; border-radius: 24rpx;
  box-shadow: 0 0 18rpx rgba(201, 160, 99, .3);
}
.member-bar::before {
  content: ''; position: absolute; top: -10rpx; right: -10rpx;
  width: 200rpx; height: 200rpx;
  background: radial-gradient(circle, rgba(201, 160, 99, .25) 0, transparent 60%);
}
.member-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx; color: #E0C48A;
}
.member-sub { font-size: 22rpx; color: #ABA0A0; margin-top: 8rpx; }
.member-btn {
  position: relative; z-index: 1; flex-shrink: 0;
  padding: 14rpx 30rpx;
  background: linear-gradient(135deg, #E0C48A, #C9A063);
  color: #1B1415; border-radius: 999rpx;
  font-size: 24rpx; font-weight: 600;
}

/* ===== 公告 ===== */
.notice {
  display: flex; align-items: center; gap: 12rpx;
  margin: 32rpx 32rpx 0; padding: 20rpx 24rpx;
  background: rgba(28, 22, 24, .6); backdrop-filter: blur(4rpx);
  border: 1rpx solid rgba(51, 43, 45, .8); border-radius: 16rpx;
}
.notice-tag {
  flex-shrink: 0; padding: 4rpx 12rpx;
  background: rgba(192, 32, 39, .18); color: #E03A3F;
  font-size: 20rpx; border-radius: 6rpx;
}
.notice-text { flex: 1; font-size: 24rpx; color: #ABA0A0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ===== 营业时段（悬浮于电话球右侧） ===== */
.foot-time {
  position: fixed; z-index: 90;
  left: 136rpx;
  bottom: calc(140rpx + constant(safe-area-inset-bottom) + 22rpx);
  bottom: calc(140rpx + env(safe-area-inset-bottom) + 22rpx);
  display: flex; align-items: center; gap: 10rpx;
  padding: 12rpx 22rpx;
  background: rgba(16, 13, 14, .55); backdrop-filter: blur(4rpx);
  border: 1rpx solid rgba(51, 43, 45, .8); border-radius: 999rpx;
}
.foot-time-ic { width: 26rpx; height: 26rpx; opacity: .55; flex-shrink: 0; }
.foot-time-txt {
  font-size: 22rpx; color: #6F6668; letter-spacing: 1rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* ===== 左侧悬浮电话球 ===== */
.call-ball {
  position: fixed; left: 28rpx; z-index: 90;
  bottom: calc(140rpx + constant(safe-area-inset-bottom));
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 88rpx; height: 88rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #C02027, #8B1418);
  border: 1rpx solid rgba(224, 196, 138, .5);
  box-shadow: 0 8rpx 20rpx rgba(192, 32, 39, .4);
}
.call-ball::after {
  content: ''; position: absolute; inset: 0; border-radius: 50%;
  border: 1rpx solid rgba(224, 196, 138, .35);
  animation: call-pulse 2.2s ease-out infinite;
}
@keyframes call-pulse {
  0% { transform: scale(1); opacity: .8; }
  100% { transform: scale(1.55); opacity: 0; }
}
.call-ball-ic { width: 40rpx; height: 40rpx; }

/* ===== 底部留白（底栏高≈96rpx + 安全区） ===== */
.page-bottom {
  height: calc(96rpx + constant(safe-area-inset-bottom));
  height: calc(96rpx + env(safe-area-inset-bottom));
}
