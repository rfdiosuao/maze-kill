.dates { white-space: nowrap; padding: 8rpx 16rpx; }
.date {
  display: inline-block; text-align: center; padding: 14rpx 20rpx; margin: 0 8rpx;
  border: 1rpx solid rgba(212,175,55,.25); border-radius: 14rpx; min-width: 128rpx;
  background: rgba(255,255,255,.03);
}
.date.on { background: rgba(177,18,24,.4); border-color: #B11218; box-shadow: 0 0 12rpx rgba(177,18,24,.4); }
.d-label { font-size: 26rpx; }
.d-week { font-size: 20rpx; }

.slots { display: flex; gap: 16rpx; padding: 4rpx 24rpx; }
.slot {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 14rpx;
  border: 1rpx solid rgba(212,175,55,.3); color: #8C8680;
}
.slot.on { background: linear-gradient(135deg, #B11218, #7A0E13); color: #F5EFE6; border-color: #D4AF37; }
.only-pref { padding: 12rpx 28rpx; }

.ses { margin: 16rpx 24rpx; padding: 20rpx 24rpx; border-radius: 16rpx; border: 1rpx solid rgba(212,175,55,.2); background: linear-gradient(135deg, #1A1113, #120C0D); }
.ses.sel { border-color: #B11218; box-shadow: 0 0 14rpx rgba(177,18,24,.45); }
.ses-name { font-size: 30rpx; font-weight: 600; }

.dms { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 14rpx; }
.dmchip {
  width: calc(25% - 12rpx); text-align: center; padding: 14rpx 6rpx;
  border: 1rpx solid rgba(212,175,55,.2); border-radius: 14rpx; background: rgba(255,255,255,.03);
}
.dmchip.sel { border-color: #D4AF37; background: rgba(212,175,55,.12); }
.dmchip-name { font-size: 24rpx; margin: 8rpx 0 2rpx; }
.dmchip-sub { font-size: 18rpx; }

.frow { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; }
.flabel { width: 110rpx; font-size: 26rpx; color: #CFC8C0; }
.finput { flex: 1; }
.fslider { flex: 1; margin: 0; }
.payops { display: flex; gap: 12rpx; flex-wrap: wrap; }
.chip { font-size: 24rpx; padding: 10rpx 22rpx; border-radius: 999rpx; border: 1rpx solid rgba(212,175,55,.3); color: #8C8680; }
.chip.on { background: rgba(177,18,24,.35); border-color: #B11218; color: #F5EFE6; }
.tip { margin-top: 14rpx; font-size: 20rpx; text-align: center; }
