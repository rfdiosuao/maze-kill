.tabs { display: flex; padding: 20rpx 24rpx 0; gap: 12rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 12rpx; border: 1rpx solid rgba(212,175,55,.25); color: #8C8680; }
.tab.on { background: linear-gradient(135deg, #B11218, #7A0E13); color: #F5EFE6; border-color: #D4AF37; }

.vipcard {
  margin: 24rpx; padding: 44rpx 36rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, #7A0E13 0%, #B11218 55%, #4A090C 100%);
  border: 1rpx solid rgba(212,175,55,.55);
  box-shadow: 0 8rpx 30rpx rgba(122,14,19,.5);
}
.vip-logo { width: 110rpx; height: 110rpx; margin-bottom: 18rpx; }
.vip-name { font-size: 26rpx; color: rgba(245,239,230,.85); letter-spacing: 2rpx; }
.vip-balance { font-size: 72rpx; font-weight: 700; color: #D4AF37; margin: 14rpx 0 6rpx; }

.coupon { padding: 16rpx 0; border-bottom: 1rpx solid rgba(255,255,255,.05); }
.coupon:last-child { border-bottom: none; }
.coupon-name { font-size: 28rpx; }

.flow { padding: 16rpx 0; border-bottom: 1rpx solid rgba(255,255,255,.05); }
.flow:last-child { border-bottom: none; }
.bk-meta { margin: 10rpx 0; }
.cancel { padding: 10rpx 30rpx !important; }
