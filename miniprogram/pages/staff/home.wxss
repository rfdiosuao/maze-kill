.head { display: flex; align-items: center; padding: 30rpx 28rpx 10rpx; }
.head-name { font-size: 38rpx; font-weight: 700; color: #D4AF37; }
.out { padding: 8rpx 26rpx !important; }

.tabs { display: flex; padding: 16rpx 24rpx; gap: 10rpx; }
.tab { flex: 1; text-align: center; padding: 14rpx 0; font-size: 26rpx; border-radius: 12rpx; border: 1rpx solid rgba(212,175,55,.25); color: #8C8680; }
.tab.on { background: linear-gradient(135deg, #B11218, #7A0E13); color: #F5EFE6; border-color: #D4AF37; }

.months { white-space: nowrap; padding: 12rpx 24rpx; }
.chip { display: inline-block; font-size: 24rpx; padding: 8rpx 22rpx; border-radius: 999rpx; border: 1rpx solid rgba(212,175,55,.3); color: #8C8680; margin-right: 10rpx; }
.chip.on { background: rgba(177,18,24,.35); border-color: #B11218; color: #F5EFE6; }

.srow { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 28rpx; }
.srow.total { font-size: 30rpx; }
.big { font-size: 44rpx; }
.drow { display: flex; align-items: center; gap: 14rpx; padding: 12rpx 0; border-bottom: 1rpx solid rgba(255,255,255,.05); }
.drow:last-child { border-bottom: none; }
.dscript { font-size: 26rpx; }

.bar { padding: 16rpx 24rpx; }
.roles { margin-top: 8rpx; }
.role { display: flex; justify-content: space-between; padding: 10rpx 0; border-bottom: 1rpx dashed rgba(212,175,55,.15); }
.role:last-child { border-bottom: none; }

.frow { display: flex; align-items: center; gap: 16rpx; padding: 12rpx 0; }
.frow.col { flex-direction: column; align-items: stretch; }
.flabel { width: 110rpx; color: #CFC8C0; flex-shrink: 0; }
.finput, .farea { flex: 1; width: auto; }
.tip { margin-top: 16rpx; text-align: center; font-size: 20rpx; }
