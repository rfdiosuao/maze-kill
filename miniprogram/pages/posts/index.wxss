/* ===== 发现 · 帖子 ===== */
page { background: #100D0E; padding-bottom: 40rpx; }

/* 顶部横幅 */
.p-hero {
  position: relative; overflow: hidden;
  margin: 16rpx 24rpx 0; padding: 40rpx 36rpx 44rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #2A0E10 0%, #100D0E 60%, #1A1010 100%);
  border: 1rpx solid rgba(201, 160, 99, .18);
}
.p-hero::after {
  content: ''; position: absolute; top: -40rpx; right: -30rpx;
  width: 220rpx; height: 220rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(201, 160, 99, .22) 0, transparent 70%);
}
.p-hero-tag {
  display: inline-block; padding: 4rpx 14rpx;
  background: rgba(192, 32, 39, .2); border: 1rpx solid rgba(192, 32, 39, .6);
  color: #E03A3F; font-size: 20rpx; letter-spacing: 2rpx; border-radius: 6rpx;
}
.p-hero-title {
  position: relative; z-index: 1;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 42rpx; font-weight: 700; color: #F4EBE9;
  letter-spacing: 2rpx; margin-top: 18rpx;
}
.p-hero-sub { position: relative; z-index: 1; margin-top: 10rpx; font-size: 24rpx; color: #ABA0A0; }

/* 分类筛选 */
.p-tabs { display: flex; gap: 16rpx; padding: 28rpx 24rpx 20rpx; }
.p-tab {
  padding: 10rpx 30rpx; border-radius: 999rpx;
  font-size: 24rpx; color: #8C8680;
  border: 1rpx solid rgba(201, 160, 99, .3);
  font-family: "Songti SC", "STSong", "SimSun", serif;
}
.p-tab.on {
  background: linear-gradient(135deg, rgba(192, 32, 39, .35), rgba(122, 14, 19, .35));
  border-color: rgba(201, 160, 99, .6); color: #E0C48A; font-weight: 600;
}

/* 双列瀑布流 */
.p-feed { columns: 2; column-gap: 16rpx; padding: 4rpx 16rpx 0; }
.post {
  break-inside: avoid; -webkit-column-break-inside: avoid;
  margin-bottom: 16rpx;
  background: #1C1618; border: 1rpx solid #332B2D; border-radius: 20rpx;
  overflow: hidden;
}
.post-cover {
  height: 200rpx; background: linear-gradient(135deg, #2A0E10, #161112);
  display: flex; align-items: center; justify-content: center;
}
.post-cover image { width: 100%; height: 100%; display: block; }
.cover-ph {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 60rpx; color: rgba(201, 160, 99, .3); letter-spacing: 4rpx;
}
.post-body { padding: 18rpx 20rpx 20rpx; }
.post-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx; font-weight: 600; line-height: 1.45; color: #F4EBE9;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden;
}
.post-author { display: flex; align-items: center; gap: 14rpx; margin-top: 18rpx; }
.author-av {
  width: 52rpx; height: 52rpx; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, #C02027, #8B1418);
  color: #FFF8F2; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 600;
}
.author-info { flex: 1; min-width: 0; }
.author-name {
  font-size: 24rpx; color: #F4EBE9; font-weight: 600;
  display: flex; align-items: center; gap: 8rpx;
}
.author-role {
  font-size: 18rpx; padding: 0 8rpx; border-radius: 6rpx; font-weight: 400;
  border: 1rpx solid rgba(201, 160, 99, .4); color: #C9A063;
}
.author-role.dm { border-color: #C02027; color: #E03A3F; }
.author-book { font-size: 20rpx; color: #6F6668; margin-top: 2rpx; }
.post-foot {
  display: flex; align-items: center; gap: 24rpx; margin-top: 16rpx;
  padding-top: 14rpx; border-top: 1rpx solid #2A2224;
}
.like, .cmt { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; color: #8C8680; }
.like.on { color: #E03A3F; }
.like-sym { font-size: 24rpx; }
.cmt-sym { font-size: 20rpx; }

/* 发帖悬浮按钮 */
.p-pub {
  position: fixed; right: 36rpx; bottom: calc(140rpx + env(safe-area-inset-bottom));
  z-index: 90;
  display: flex; align-items: center; gap: 6rpx;
  padding: 18rpx 30rpx;
  background: linear-gradient(135deg, #C02027, #8B1418);
  border: 1rpx solid rgba(224, 196, 138, .5);
  border-radius: 999rpx; color: #FFF8F2;
  box-shadow: 0 8rpx 24rpx rgba(192, 32, 39, .4);
}
.p-pub-plus { font-size: 34rpx; line-height: 1; }
.p-pub-txt { font-size: 26rpx; font-weight: 600; }

/* 底部留白（底栏高≈96rpx + 安全区） */
.page-bottom {
  height: calc(96rpx + constant(safe-area-inset-bottom));
  height: calc(96rpx + env(safe-area-inset-bottom));
}
