/* ===== 未登录 Hero ===== */
.hero { padding: 120rpx 48rpx 60rpx; text-align: center; }
.hero-logo {
  display: block; width: 160rpx; height: 160rpx; margin: 0 auto 32rpx;
}
.hero-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx; font-weight: 700; letter-spacing: 4rpx; color: #F5EFE6;
}
.hero-sub { margin-top: 16rpx; font-size: 24rpx; color: #8C8680; line-height: 1.8; }
.login-btn {
  margin: 64rpx 32rpx 0; padding: 24rpx 0;
  background: linear-gradient(135deg, #B11218 0%, #7A0E13 100%);
  border: 1rpx solid rgba(212,175,55,.45); border-radius: 999rpx;
  color: #F5EFE6; font-size: 32rpx; font-weight: 600; letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(177,18,24,.35);
}
.hero-tip { margin-top: 28rpx; font-size: 20rpx; color: #6F6668; }

/* ===== 账户卡 ===== */
.ucard {
  display: flex; align-items: center; gap: 28rpx;
  margin: 32rpx 32rpx 0; padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #1A0F0F 0%, #2A1414 100%);
  border: 1rpx solid #C9A063; border-radius: 24rpx;
  box-shadow: 0 0 18rpx rgba(201,160,99,.25);
}
.avatar-btn {
  position: relative; padding: 0; margin: 0; line-height: 1;
  background: transparent; border: none; border-radius: 50%;
  width: 128rpx; height: 128rpx; overflow: visible;
}
.avatar-btn::after { border: none; }
.uavatar {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: #241719; border: 2rpx solid rgba(212,175,55,.4);
}
.uavatar-ph {
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; color: #D4AF37;
}
.avatar-edit {
  position: absolute; left: 50%; bottom: -12rpx; transform: translateX(-50%);
  padding: 2rpx 14rpx; font-size: 18rpx; color: #F5EFE6;
  background: rgba(13,11,12,.9); border: 1rpx solid rgba(212,175,55,.5);
  border-radius: 999rpx; white-space: nowrap;
}
.uinfo { flex: 1; min-width: 0; }
.urow { display: flex; align-items: center; gap: 12rpx; }
.uname { font-size: 34rpx; font-weight: 600; color: #F5EFE6; }
.badge-dm, .badge-player {
  flex-shrink: 0; font-size: 20rpx; padding: 2rpx 14rpx;
  border-radius: 6rpx; letter-spacing: 2rpx;
}
.badge-dm {
  background: linear-gradient(135deg, #D4AF37, #C9A063);
  color: #1B1415; font-weight: 700;
  box-shadow: 0 0 10rpx rgba(212,175,55,.5);
}
.badge-player { border: 1rpx solid rgba(212,175,55,.4); color: #D4AF37; }
.uinfo .muted { margin-top: 6rpx; word-break: break-all; }

/* ===== 资料卡 ===== */
.frow { display: flex; align-items: center; gap: 16rpx; }
.flabel { width: 110rpx; flex-shrink: 0; font-size: 26rpx; color: #8C8680; }
.finput { flex: 1; }
.mini-btn { flex-shrink: 0; padding: 10rpx 26rpx; font-size: 24rpx; }

/* ===== DM 工作台横幅 ===== */
.dm-banner {
  display: flex; align-items: center; gap: 16rpx;
  margin: 24rpx 32rpx 0; padding: 30rpx 32rpx;
  background: linear-gradient(135deg, rgba(177,18,24,.35) 0%, rgba(122,14,19,.35) 100%);
  border: 1rpx solid rgba(212,175,55,.5); border-radius: 20rpx;
  box-shadow: 0 0 16rpx rgba(177,18,24,.3);
}
.dm-left { flex: 1; }
.dm-title {
  font-size: 32rpx; font-weight: 700; color: #D4AF37; letter-spacing: 2rpx;
}
.dm-sub { margin-top: 6rpx; font-size: 22rpx; color: #ABA0A0; }
.dm-go { font-size: 26rpx; color: #D4AF37; }

/* ===== 菜单 ===== */
.menu {
  margin: 24rpx 32rpx 80rpx;
  background: #1C1618; border: 1rpx solid #332B2D; border-radius: 20rpx;
  overflow: hidden;
}
.menu-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 30rpx 30rpx;
}
.menu-item + .menu-item { border-top: 1rpx solid #2A2224; }
.menu-ic { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.menu-text { flex: 1; font-size: 28rpx; color: #F4EBE9; }
.menu-arrow { font-size: 28rpx; color: #6F6668; }

/* 底部固定导航留白（底栏高≈96rpx + 安全区） */
.tab-space {
  height: calc(96rpx + constant(safe-area-inset-bottom));
  height: calc(96rpx + env(safe-area-inset-bottom));
}
